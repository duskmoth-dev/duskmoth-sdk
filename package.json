{
  "name": "@duskmoth-dev/sdk",
  "version": "0.2.1",
  "type": "module",
  "private": false,
  "description": "Dependency-free Duskmoth HTTP client with Moth Pass, AI Pack, and Payroll authorization. No wallet signing or transaction broadcasting.",
  "license": "MIT",
  "author": {
    "name": "Duskmoth",
    "email": "hello@duskmoth.xyz"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/duskmoth-dev/duskmoth-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/duskmoth-dev/duskmoth-sdk/issues"
  },
  "homepage": "https://duskmoth.xyz",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check:package": "node scripts/check-package.mjs",
    "example:status": "node examples/status.mjs",
    "example:screen": "node examples/screen.mjs",
    "prepublishOnly": "npm test && npm run check:package"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "docs",
    "examples"
  ]
}
